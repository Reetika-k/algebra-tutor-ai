# ---- LLM provider ----
# "claude" (default when ANTHROPIC_API_KEY is set) or "ollama" (local, offline)
LLM_PROVIDER=claude

# Claude API (https://console.anthropic.com) — never commit the real key
ANTHROPIC_API_KEY=sk-ant-...
# Any current Claude model id; default is claude-opus-5
CLAUDE_MODEL=claude-opus-5

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:7b

# Server
PORT=3000
